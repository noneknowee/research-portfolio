---
import { ArrowLeft, Clock, PencilLine } from '@lucide/astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { mediaWithBase, withBase } from '../../config';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter((article) => article.data.status === 'published' || import.meta.env.DEV)
    .map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const { title, description, category, tags, publishedAt, updatedAt, readingMinutes, challenge, status, coverImage, coverAlt, attachment } = article.data;
const date = publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} theme="paper">
  <article class="reading-page">
    <header class="article-hero">
      <a class="back-link" href={withBase('writing')}><ArrowLeft size={17} /> 返回文章索引</a>
      <div class="article-hero__meta">
        <span>{category}</span>
        <time datetime={publishedAt.toISOString()}>{date}</time>
        {readingMinutes && <span><Clock size={14} /> {readingMinutes} 分钟</span>}
        {status === 'draft' && <span class="draft-label">示例草稿</span>}
      </div>
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      {challenge && (
        <div class="article-thesis">
          <span>本文试图挑战</span>
          <p>{challenge}</p>
        </div>
      )}
      <div class="tag-list">{tags.map((tag) => <span>{tag}</span>)}</div>
      {coverImage && <img class="article-cover" src={mediaWithBase(coverImage)} alt={coverAlt || ''} />}
    </header>

    <div class="reading-layout">
      <aside class="article-toc" aria-label="文章目录">
        <span>本文结构</span>
        <ol>
          {headings.filter((heading) => heading.depth === 2).map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </aside>
      <div class="prose">
        <Content />
        {attachment && <p class="article-attachment"><a href={mediaWithBase(attachment)}>下载文章附件</a></p>}
        {updatedAt && (
          <p class="revision-note"><PencilLine size={16} /> 最近修订：{updatedAt.toLocaleDateString('zh-CN')}</p>
        )}
      </div>
    </div>

    <section class="article-subscribe">
      <div>
        <h2>继续追踪这些判断如何被修正</h2>
        <p>订阅后只接收新文章和重要修订。</p>
      </div>
      <NewsletterForm />
    </section>
  </article>
</BaseLayout>
