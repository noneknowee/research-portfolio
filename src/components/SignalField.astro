<div class="signal-field" aria-hidden="true">
  <canvas id="signal-canvas"></canvas>
  <div class="signal-field__readout">
    <span>ASSUMPTIONS</span>
    <span>DRIVERS</span>
    <span>COUNTERFACTUALS</span>
  </div>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#signal-canvas');
  if (canvas) {
    const targetCanvas = canvas;
    const ctx = targetCanvas.getContext('2d');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pointer = { x: 0.52, y: 0.45 };
    let width = 0;
    let height = 0;
    let frame = 0;
    let animationId = 0;
    type SignalPoint = {
      x: number;
      y: number;
      originX: number;
      originY: number;
      size: number;
      speed: number;
      phase: number;
      color: string;
    };
    let points: SignalPoint[] = [];

    const palette = ['#7ee7f2', '#f26f5b', '#c5f36d', '#d9dfdc'];

    function createPoints() {
      const count = Math.max(70, Math.min(160, Math.round((width * height) / 8500)));
      points = Array.from({ length: count }, (_, index) => {
        const band = index % 5;
        return {
          x: Math.random(),
          y: Math.random(),
          originX: Math.random(),
          originY: Math.random(),
          size: band === 0 ? 2.2 : Math.random() * 1.3 + 0.45,
          speed: Math.random() * 0.004 + 0.001,
          phase: Math.random() * Math.PI * 2,
          color: palette[index % palette.length],
        };
      });
    }

    function resize() {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const rect = targetCanvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      targetCanvas.width = Math.floor(width * ratio);
      targetCanvas.height = Math.floor(height * ratio);
      ctx?.setTransform(ratio, 0, 0, ratio, 0, 0);
      createPoints();
      draw();
    }

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = '#090b0c';
      ctx.fillRect(0, 0, width, height);

      const focusX = pointer.x * width;
      const focusY = pointer.y * height;

      points.forEach((point, index) => {
        const wave = Math.sin(frame * point.speed + point.phase);
        const px = point.x * width + wave * 10;
        const py = point.y * height + Math.cos(frame * point.speed * 0.8 + point.phase) * 8;
        const dx = px - focusX;
        const dy = py - focusY;
        const distance = Math.hypot(dx, dy);
        const proximity = Math.max(0, 1 - distance / Math.min(width, height) / 0.62);
        const alpha = 0.13 + proximity * 0.72;

        ctx.beginPath();
        ctx.fillStyle = `${point.color}${Math.round(alpha * 255).toString(16).padStart(2, '0')}`;
        ctx.arc(px, py, point.size + proximity * 1.6, 0, Math.PI * 2);
        ctx.fill();

        if (proximity > 0.4 && index % 3 === 0) {
          const target = points[(index + 11) % points.length];
          const tx = target.x * width + Math.sin(frame * target.speed + target.phase) * 10;
          const ty = target.y * height + Math.cos(frame * target.speed * 0.8 + target.phase) * 8;
          ctx.beginPath();
          ctx.strokeStyle = `rgba(126, 231, 242, ${proximity * 0.18})`;
          ctx.lineWidth = 0.7;
          ctx.moveTo(px, py);
          ctx.lineTo(tx, ty);
          ctx.stroke();
        }
      });

      const glow = ctx.createRadialGradient(focusX, focusY, 0, focusX, focusY, Math.min(width, height) * 0.34);
      glow.addColorStop(0, 'rgba(126, 231, 242, 0.12)');
      glow.addColorStop(0.45, 'rgba(242, 111, 91, 0.035)');
      glow.addColorStop(1, 'rgba(9, 11, 12, 0)');
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);

      frame += 1;
      if (!reduceMotion) animationId = requestAnimationFrame(draw);
    }

    targetCanvas.addEventListener('pointermove', (event) => {
      const rect = targetCanvas.getBoundingClientRect();
      pointer.x = (event.clientX - rect.left) / rect.width;
      pointer.y = (event.clientY - rect.top) / rect.height;
    });
    targetCanvas.addEventListener('pointerleave', () => {
      pointer.x = 0.52;
      pointer.y = 0.45;
    });

    const observer = new ResizeObserver(resize);
    observer.observe(targetCanvas);
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationId);
      observer.disconnect();
    }, { once: true });
  }
</script>
