---
import { BriefcaseBusiness, Rss, Terminal } from '@lucide/astro';
import { siteConfig, withBase } from '../config';
interface Props { theme?: 'dark' | 'paper' }
const { theme = 'dark' } = Astro.props;
---

<footer class:list={['site-footer', { 'site-footer--paper': theme === 'paper' }]}>
  <p>{siteConfig.footerStatement}</p>
  <div class="footer-links">
    <a href={siteConfig.links.github} aria-label="GitHub"><Terminal size={18} /></a>
    <a href={siteConfig.links.linkedin} aria-label="LinkedIn"><BriefcaseBusiness size={18} /></a>
    <a href={withBase('rss.xml')} aria-label="RSS"><Rss size={18} /></a>
  </div>
  <small>© {new Date().getFullYear()} {siteConfig.name}</small>
</footer>
