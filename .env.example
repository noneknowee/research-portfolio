# Full deployed URL, including the repository path for GitHub project pages.
SITE_URL=https://your-name.github.io/your-repository

# Use / for a custom domain or username.github.io repository.
BASE_PATH=/your-repository

# Paste the form action supplied by Buttondown, Kit, Mailchimp, etc.
# Example: https://buttondown.com/api/emails/embed-subscribe/your-name
PUBLIC_NEWSLETTER_ACTION=
